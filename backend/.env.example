# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env — it is listed in .gitignore.

# PostgreSQL connection string
# Local example:   postgresql://postgres:password@localhost:5432/pos_db
# Render example:  postgresql://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# JWT / auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP / 2FA — generate with: python -c "import pyotp; print(pyotp.random_base32())"
OTP_SECRET=REPLACE_WITH_PYOTP_BASE32_SECRET